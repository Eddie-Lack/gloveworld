--- /dev/null
+++ b/gtrace.h
@@ -0,0 +1,13 @@
+/* Trace output for matching work: set GTRACE=1, and GTRACE_FN=name to limit it to one function. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+extern char *current_function_name;
+static int
+gtrace_on ()
+{
+  char *f = getenv ("GTRACE_FN");
+  if (!getenv ("GTRACE"))
+    return 0;
+  return !f || (current_function_name && !strcmp (f, current_function_name));
+}
